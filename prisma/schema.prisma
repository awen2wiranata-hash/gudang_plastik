generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// 2. Tabel Master Barang (Jenis Plastik)
model Barang {
  id           String   @id @default(cuid())
  kodeBarang   String   @unique
  namaBarang   String
  kategori     String?
  gambarUrl    String?
  stokSekarang Int      @default(0)
  leadTime     Int      @default(1)
  isAktif      Boolean  @default(true)

  riwayatMasuk  BarangMasuk[]
  riwayatKeluar BarangKeluar[]
  dataPeramalan Peramalan[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 3. Tabel Supplier (Pabrik Plastik)
model Supplier {
  id             String           @id @default(cuid())
  namaPabrik     String
  kontak         String?
  alamat         String?
  transaksiMasuk TransaksiMasuk[]
  createdAt      DateTime         @default(now())
}

// 4. Tabel Header Transaksi Masuk
model TransaksiMasuk {
  id           String        @id @default(cuid())
  nomorNota    String        @unique
  tanggal      DateTime      @default(now())
  supplierId   String
  supplier     Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  detailBarang BarangMasuk[]
}

// 5. Tabel Detail Barang Masuk
model BarangMasuk {
  id               String         @id @default(cuid())
  jumlah           Int
  tanggalMasuk     DateTime       @default(now())
  barangId         String
  barang           Barang         @relation(fields: [barangId], references: [id], onDelete: Cascade)
  transaksiMasukId String
  transaksiMasuk   TransaksiMasuk @relation(fields: [transaksiMasukId], references: [id], onDelete: Cascade)
}

// 6. Tabel Customer
model Customer {
  id              String            @id @default(cuid())
  nama            String
  kontak          String?
  alamat          String?
  transaksiKeluar TransaksiKeluar[]
  createdAt       DateTime          @default(now())
}

// 7. Tabel Header Transaksi Keluar
model TransaksiKeluar {
  id           String         @id @default(cuid())
  nomorNota    String         @unique
  tanggal      DateTime       @default(now())
  customerId   String
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  detailBarang BarangKeluar[]
}

// 8. Tabel Detail Barang Keluar
model BarangKeluar {
  id                String          @id @default(cuid())
  jumlah            Int
  tanggalKeluar     DateTime        @default(now())
  barangId          String
  barang            Barang          @relation(fields: [barangId], references: [id], onDelete: Cascade)
  transaksiKeluarId String
  transaksiKeluar   TransaksiKeluar @relation(fields: [transaksiKeluarId], references: [id], onDelete: Cascade)
}

// 9. Tabel Peramalan
model Peramalan {
  id           String   @id @default(cuid())
  tanggalAwal  DateTime
  tanggalAkhir DateTime
  nilaiSMA     Float
  nilaiMAPE    Float?
  rop          Float?
  barangId     String
  barang       Barang   @relation(fields: [barangId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  nama      String
  username  String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  username  String
  role      String
  aksi      String
  nomorNota String?
  dataLama  String?
  dataBaru  String?
  tanggal   DateTime @default(now())
}